PORT=3000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Minimo 16 caracteres
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Opcionales: si estan presentes se crea el admin al arrancar (si no existe)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opcional: habilita el botón "Autocompletar con IA" en el form de productos
# (POST /products/ai-lookup). Sin esto, ese endpoint responde 503 pero el resto
# de la app funciona igual. Key de https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Debe ser servido directamente por el provider "deepseek" en OpenRouter para
# que tu BYOK de DeepSeek (si lo configuraste en openrouter.ai/integrations) aplique.
DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash-1017

# Identificación legal/comercial (GET /api/v1/legal/info, consumida por el footer y las
# páginas legales del frontend). Opcionales: sin setearlas se muestran placeholders
# "[COMPLETAR: ...]" explícitos en vez de datos inventados. Ver COMPLIANCE_ARGENTINA.md.
LEGAL_BUSINESS_NAME=Essence Vapes
LEGAL_LEGAL_NAME=
LEGAL_CUIT=
LEGAL_ADDRESS=
LEGAL_PROVINCE=
LEGAL_LOCALITY=
LEGAL_SUPPORT_EMAIL=
LEGAL_WHATSAPP=
LEGAL_BUSINESS_HOURS=

# Por defecto (false) los vapes sembrados siguen visibles/comprables tal como hoy (decisión
# del titular). Ponerlo en true activa el filtro real que excluye del catálogo público todo
# producto "vapes" sin autorización sanitaria verificada (saleAuthorizationStatus=autorizado).
VAPES_SALE_ENFORCEMENT_ENABLED=false

# Opcional, no usado todavía: no hay librería de email instalada, así que esto no envía nada
# por sí solo. El seguimiento de solicitudes de arrepentimiento hoy es 100% vía panel admin.
WITHDRAWAL_NOTIFICATION_EMAIL=
