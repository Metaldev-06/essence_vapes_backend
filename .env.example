PORT=3000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Minimo 16 caracteres
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Opcionales: si estan presentes se crea el admin al arrancar (si no existe)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opcional: habilita el botón "Autocompletar con IA" en el form de productos
# (POST /products/ai-lookup). Sin esto, ese endpoint responde 503 pero el resto
# de la app funciona igual. Key de https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Debe ser servido directamente por el provider "deepseek" en OpenRouter para
# que tu BYOK de DeepSeek (si lo configuraste en openrouter.ai/integrations) aplique.
DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash-1017

# Identificación legal/comercial (GET /api/v1/legal/info, consumida por el footer y las
# páginas legales del frontend). Opcionales: sin setearlas se muestran placeholders
# "[COMPLETAR: ...]" explícitos en vez de datos inventados. Ver COMPLIANCE_ARGENTINA.md.
LEGAL_BUSINESS_NAME=Essence Vapes
LEGAL_LEGAL_NAME=
LEGAL_CUIT=
LEGAL_ADDRESS=
LEGAL_PROVINCE=
LEGAL_LOCALITY=
LEGAL_SUPPORT_EMAIL=
LEGAL_WHATSAPP=
LEGAL_BUSINESS_HOURS=

# Por defecto (false) los vapes sembrados siguen visibles/comprables tal como hoy (decisión
# del titular). Ponerlo en true activa el filtro real que excluye del catálogo público todo
# producto "vapes" sin autorización sanitaria verificada (saleAuthorizationStatus=autorizado).
VAPES_SALE_ENFORCEMENT_ENABLED=false

# Opcional: a dónde se notifica un nuevo trámite de arrepentimiento por email
# (default: RESEND_FROM_SUPPORT / soporte@essencevapes.com.ar si no se setea).
WITHDRAWAL_NOTIFICATION_EMAIL=

# Resend (https://resend.com/api-keys) - envío real de emails. Sin RESEND_API_KEY seteada,
# estos flujos simplemente no envían nada (se loguea) en vez de romper el request.
RESEND_API_KEY=
# Las 4 direcciones reales del negocio en Resend - cada una con un uso distinto. Los defaults
# de abajo ya son los correctos; solo hace falta sobreescribir si cambian los dominios/alias.
RESEND_FROM_NO_REPLY=no-reply@essencevapes.com.ar
RESEND_FROM_CONTACT=contacto@essencevapes.com.ar
RESEND_FROM_SALES=ventas@essencevapes.com.ar
RESEND_FROM_SUPPORT=soporte@essencevapes.com.ar
# Opcional: a dónde se notifica un nuevo mensaje de contacto
# (default: RESEND_FROM_CONTACT / contacto@essencevapes.com.ar si no se setea).
CONTACT_NOTIFICATION_EMAIL=

# --- Seguridad (ver BACKEND_SECURITY.md para el detalle completo) ---

# Hops de reverse proxy confiables delante de Node, para que `request.ip` sea la IP real del
# cliente (no la del proxy) y no se pueda falsear con X-Forwarded-For. En la infra real de
# este proyecto (VPS propia con Dokploy/Traefik, SIN Cloudflare) es 1. Si alguna vez se agrega
# Cloudflare u otro proxy delante de Traefik, subir este número.
TRUST_PROXY_HOPS=1

# Orígenes permitidos por CORS, separados por coma. En producción, el dominio real del
# frontend (nunca "*"). En desarrollo, el default ya alcanza.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Rate limiting genérico (@nestjs/throttler) - valores en ms salvo los *_MAX.
THROTTLE_GLOBAL_MAX=100
THROTTLE_GLOBAL_TTL_MS=60000
# Los de catálogo/formularios públicos/lookup/admin están hardcodeados como override por ruta
# (@Throttle en cada controller) - estas env vars quedan documentadas para referencia pero
# cambiar el número real hoy requiere tocar ese decorador, no estas variables.
THROTTLE_CATALOG_MAX=60
THROTTLE_CATALOG_TTL_MS=60000
THROTTLE_PUBLIC_FORM_MAX=5
THROTTLE_PUBLIC_FORM_TTL_MS=600000
THROTTLE_LOOKUP_MAX=20
THROTTLE_LOOKUP_TTL_MS=900000
THROTTLE_ADMIN_MAX=30
THROTTLE_ADMIN_TTL_MS=60000

# Fuerza bruta de login - independiente por cuenta Y por IP (BruteForceService). Bloqueos
# temporales con duración creciente (INITIAL * MULTIPLIER^tier, tope MAX_MS) - nunca permanentes.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_FAILED_WINDOW_MS=900000
AUTH_LOCKOUT_INITIAL_MS=300000
AUTH_LOCKOUT_MULTIPLIER=3
AUTH_LOCKOUT_MAX_MS=3600000

# Bloqueo temporal de IPs por patrones de abuso (401/403/404 reiterados, scraping de rutas
# admin) - AbuseDetectionService. Nunca se dispara con un solo evento.
ABUSE_SUSPICIOUS_MAX=15
ABUSE_SUSPICIOUS_WINDOW_MS=300000
ABUSE_BLOCK_INITIAL_MS=600000
ABUSE_BLOCK_MULTIPLIER=3
ABUSE_BLOCK_MAX_MS=86400000

# Audit trail de seguridad (tabla security_events) - apagarlo no afecta el bloqueo de IPs ni
# el rate limiting, solo deja de guardarse el registro.
SECURITY_LOGGING_ENABLED=true
